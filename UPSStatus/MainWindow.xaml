<Window x:Class="UPSStatus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UPSStatus"
        mc:Ignorable="d"
        Title="UPS Status Monitor" Height="420" Width="480"
        ResizeMode="CanMinimize"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1a1a1a"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.10" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- connection bar -->
            <RowDefinition Height="Auto"/>  <!-- warning banner -->
            <RowDefinition Height="*"/>     <!-- metrics -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Connection bar -->
        <Border Grid.Row="0" Background="#2D3A4A" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Host:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox  Grid.Column="1" x:Name="HostBox" Text="192.168.8.55" VerticalAlignment="Center" Padding="4,3" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="2" Text="Port:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox  Grid.Column="3" x:Name="PortBox" Text="3551" Width="52" VerticalAlignment="Center" Padding="4,3" Margin="0,0,10,0"/>
                <Button   Grid.Column="4" x:Name="RefreshButton" Content="Refresh" Padding="10,3"
                          Click="RefreshButton_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Warning banner (hidden by default) -->
        <Border Grid.Row="1" x:Name="WarningBanner" Background="#E53935" Padding="12,7"
                Visibility="Collapsed">
            <TextBlock Text="⚠  UPS IS RUNNING ON BATTERY!" Foreground="White"
                       FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
        </Border>

        <!-- Metrics -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,10,14,4">
            <StackPanel>

                <!-- Status -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Status"/>
                        <TextBlock Grid.Column="1" x:Name="StatusValue" Style="{StaticResource ValueStyle}" Text="—"/>
                    </Grid>
                </Border>

                <!-- Battery charge -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Battery Charge"/>
                            <TextBlock Grid.Column="1" x:Name="BatteryValue" Style="{StaticResource ValueStyle}" Text="—"/>
                        </Grid>
                        <ProgressBar x:Name="BatteryBar" Height="8" Minimum="0" Maximum="100"
                                     Foreground="#43A047" Background="#E0E0E0" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Time left -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Time Left"/>
                        <TextBlock Grid.Column="1" x:Name="TimeLeftValue" Style="{StaticResource ValueStyle}" Text="—"/>
                    </Grid>
                </Border>

                <!-- Load percent -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Load"/>
                            <TextBlock Grid.Column="1" x:Name="LoadValue" Style="{StaticResource ValueStyle}" Text="—"/>
                        </Grid>
                        <ProgressBar x:Name="LoadBar" Height="8" Minimum="0" Maximum="100"
                                     Foreground="#FB8C00" Background="#E0E0E0" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- Line voltage -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Line Voltage"/>
                        <TextBlock Grid.Column="1" x:Name="VoltageValue" Style="{StaticResource ValueStyle}" Text="—"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#E8EAED" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Text="Not connected" Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="NextRefreshText" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
